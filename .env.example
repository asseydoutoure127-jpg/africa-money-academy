# Copiez ces lignes dans les variables d'environnement de Vercel (Settings > Environment Variables).
# Ne mettez JAMAIS ce fichier rempli sur GitHub.

# --- OBLIGATOIRES ---------------------------------------------------------
# Adresse de la base Neon (choisir l'adresse « pooled » / avec -pooler).
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clé qui chiffre les secrets enregistrés en base. 48 caractères au hasard minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# ATTENTION : si vous la changez, il faudra ressaisir la clé Chariow et les secrets de Pulse.
APP_SECRET=

# Adresse publique du site, en HTTPS, sans « / » à la fin (Chariow exige HTTPS pour le webhook).
SITE_URL=https://votre-domaine.com

# Mot à usage unique qui protège la page /setup (création du premier administrateur).
SETUP_TOKEN=

# Protège la tâche automatique de réconciliation. Vercel l'envoie tout seul au Cron.
CRON_SECRET=

# --- OPTIONNELLES (tout peut aussi se saisir dans Admin > Réglages > Connexions) -------
# Quand les deux existent, la valeur saisie dans l'admin PRIME sur la variable.
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
CHARIOW_PULSE_ID=
RESEND_API_KEY=
MAIL_FROM="Africa Money Academy <contact@votre-domaine.com>"
SITE_NAME=Africa Money Academy
SUPPORT_EMAIL=contact@votre-domaine.com

# Pour servir l'admin sur une adresse distincte (ex. admin.votre-domaine.com). Laisser vide sinon.
ADMIN_HOST=
